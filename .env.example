# Copy this file to .env.local for local development (`npm run dev`).
# In production, set each value as a Cloudflare secret:
#   npx wrangler secret put ADMIN_PASSWORD
# Never commit real values. .env and .env.local are gitignored.

# ── Required ────────────────────────────────────────────────────────────────

# Password for the admin (The Wifii). Unlocks /dashboard (with ADMIN_EMAIL) and /dj-builder.
# Use a long random value: it also signs session cookies unless SESSION_SECRET is set.
ADMIN_PASSWORD=

# ── AI DJ Setlist Builder (/dj-builder) ─────────────────────────────────────

# Anthropic API key for the AI DJ chat. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Spotify Developer App credentials. https://developer.spotify.com/dashboard
# Add this redirect URI to the app: https://thewifii.com/api/spotify/callback
# (for local development also add http://127.0.0.1:3000/api/spotify/callback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Created by the one-time setup at /api/spotify/login. The callback page shows the value to paste here.
SPOTIFY_REFRESH_TOKEN=

# Optional. Adds GetSongBPM as a fallback tempo source when AcousticBrainz has no data.
# https://getsongbpm.com/api (requires the attribution link, which is already in the site footer)
GETSONGBPM_API_KEY=

# ── Optional overrides ──────────────────────────────────────────────────────

# Email the admin signs in with on /login. Default: admin@thewifii.com
# ADMIN_EMAIL=admin@thewifii.com

# Separate secret for signing session cookies. Default: ADMIN_PASSWORD.
# SESSION_SECRET=

# Claude model for the AI DJ. Default: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Force a specific Spotify redirect URI. Default: <this site's origin>/api/spotify/callback
# SPOTIFY_REDIRECT_URI=https://thewifii.com/api/spotify/callback

# GetSongBPM API host. Default: https://api.getsong.co
# GETSONGBPM_API_BASE=https://api.getsong.co

# Public site URL used for canonical links and the sitemap. Set in wrangler.toml for production.
# SITE_URL=http://localhost:3000
