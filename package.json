{
  "name": "thewifii",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-sql.ts",
    "db:init:local": "wrangler d1 execute thewifii-db --local --file=./schema.sql && wrangler d1 execute thewifii-db --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute thewifii-db --remote --file=./schema.sql && wrangler d1 execute thewifii-db --remote --file=./seed.sql",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.163.0"
  }
}
